{
  "build": {
    "steps": [
      {
        "name": "install",
        "commands": [
          "python -m venv /app/.venv",
          "pip install -r requirements.txt",
          "ln -sf /app/.venv/bin/uvicorn /usr/local/bin/uvicorn",
          "ln -sf /app/.venv/bin/python /usr/local/bin/venv-python"
        ]
      }
    ]
  }
}
